{
  "manifest_version": 3,
  "name": "Irie",
  "description": "Tools that run on this computer, beside the page you're on: what a site's terms of service mean for you, in plain words, and answers to your questions about them.",
  "version": "0.0.0",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging",
    "storage",
    "sidePanel"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "Irie",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "sidebar_action": {
    "default_title": "Irie",
    "default_panel": "panel.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    },
    "open_at_install": false
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
